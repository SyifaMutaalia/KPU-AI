APP_ENV=development
APP_NAME=KPU Subang AI Agent Backend
RAG_ENABLED=true
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql+psycopg://kpu_app:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:5432/kpu_agent
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=kpu-subang

ADMIN_LOGIN_RATE_LIMIT=8
ADMIN_RESET_RATE_LIMIT=5
ADMIN_SESSION_TTL_HOURS=12
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
ADMIN_RETRY_WEBHOOK_URL=
ADMIN_RETRY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_VALUE
INGESTION_CALLBACK_SECRET=REPLACE_WITH_RANDOM_VALUE
ADMIN_RESET_URL=http://localhost:3000/admin/reset-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
