# Copy to .env on EC2; NEVER commit .env
N8N_HOST=n8n.example.org
APP_HOST=admin.example.org
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
APP_DB_NAME=kpu_agent
APP_DB_USER=kpu_app
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_URL_SAFE_RANDOM_PASSWORD

APP_ENV=production
APP_NAME=KPU Subang AI Agent Backend
RAG_ENABLED=true
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=["https://admin.example.org"]
# Frontend di Vercel (opsional): origin produksi Vercel (tanpa garis miring akhir)
# dan domain publik untuk backend FastAPI (DNS diarahkan ke EC2 ini).
# VERCEL_ORIGIN=https://kpu-agent.vercel.app
# API_HOST=api.example.org
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=kpu_kab_subang

ADMIN_LOGIN_RATE_LIMIT=8
ADMIN_RESET_RATE_LIMIT=5
ADMIN_SESSION_TTL_HOURS=12
N8N_API_URL=http://n8n:5678
N8N_API_KEY=
ADMIN_RETRY_WEBHOOK_URL=
ADMIN_RETRY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_VALUE
INGESTION_CALLBACK_SECRET=REPLACE_WITH_RANDOM_VALUE
ADMIN_RESET_URL=https://admin.example.org/admin/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
