    {
      "parameters": {
        "jsCode": "// Input dari webhook: manual ingest ({ pdf_url, title?, ... }) atau Retry dari dashboard admin ({ error_id, ... }).\nconst body = $input.first().json.body ?? {};\nconst pick = (v) => (typeof v === 'string' && v.trim() ? v.trim() : null);\nconst pdfUrl = pick(body.pdf_url);\nif (pdfUrl && !/^https:\\/\\/[^\\s]+$/i.test(pdfUrl)) {\n  throw new Error('pdf_url harus berupa URL https.');\n}\nconst yearNum = Number(body.year);\nreturn [{\n  json: {\n    pdf_url: pdfUrl,\n    retry_error_id: pick(body.retry_error_id) ?? pick(body.error_id),\n    source: pick(body.source) ?? (pdfUrl ? 'Webhook' : 'Retry Admin'),\n    document_type: pick(body.document_type),\n    document_number: pick(body.document_number),\n    title: pick(body.title),\n    year: Number.isInteger(yearNum) && yearNum >= 1800 && yearNum <= 2200 ? yearNum : null,\n  },\n}];\n"
      },
