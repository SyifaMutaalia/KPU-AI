    },
    {
      "parameters": {
        "jsCode": "// Output Pinecone (mode insert) = satu item per chunk yang berhasil di-upsert.\n// Status sukses hanya dikirim dari sini, yaitu setelah Pinecone menerima upsert.\nconst groups = new Map();\n$input.all().forEach((item, i) => {\n  const meta = item.json.metadata ?? {};\n  let doc = null;\n  let fileHash = null;\n  try { doc = $('Siapkan Dokumen').itemMatching(i).json; } catch (e) {}\n  try { fileHash = $('Hitung Hash File').itemMatching(i).json.file_hash; } catch (e) {}\n  const sourceUrl = meta.source_url || doc?.pdf_url;\n  if (!sourceUrl) {\n    throw new Error('source_url hasil upsert Pinecone tidak diketahui; callback admin dibatalkan.');\n  }\n  if (!groups.has(sourceUrl)) {\n    groups.set(sourceUrl, { doc: doc ?? {}, fileHash: meta.file_hash || fileHash || null, chunks: 0, pasal: new Set() });\n  }\n  const g = groups.get(sourceUrl);\n  g.chunks += 1;\n  for (const m of String(item.json.pageContent ?? '').matchAll(/\\bPasal\\s+(\\d+[A-Z]?)\\b/g)) g.pasal.add(m[1]);\n});\n\nreturn [...groups.entries()].map(([sourceUrl, g]) => ({\n  json: {\n    workflow: 'WF1',\n    execution_id: String($execution.id),\n    status: 'success',\n    source_url: sourceUrl,\n    document_type: g.doc.document_type ?? null,\n    document_number: g.doc.document_number ?? null,\n    title: g.doc.title ?? null,\n    year: g.doc.year ?? null,\n    file_hash: g.fileHash,\n    namespace: 'kpu_jdih',\n    chunks_count: g.chunks,\n    pasal_count: g.pasal.size || null,\n    pinecone_confirmed: true,\n    retry_error_id: g.doc.retry_error_id ?? null,\n  },\n}));\n"
      },
