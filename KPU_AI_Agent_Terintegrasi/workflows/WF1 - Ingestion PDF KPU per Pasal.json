    {
      "parameters": {
        "jsCode": "const html = $input.first().json.html || \"\";\n\nconst matches = [...html.matchAll(\n  /href\\s*=\\s*[\"']([^\"']+)[\"']/gi\n)];\n\nconst detailUrls = [...new Set(\n  matches.map(m => m[1]).filter(url =>\n    /^https:\\/\\/jdih\\.kpu\\.go\\.id\\/(peraturan-kpu|keputusan-kpu)\\/detail\\//i.test(url)\n  )\n)];\n\nreturn detailUrls.map(detail_url => ({\n  json: { detail_url, source: \"JDIH KPU\" }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        704
      ],
      "id": "b77cb3d0-8a58-4f8c-afe0-bf839e265dd8",
      "name": "ambil URL dan metadata PDF"
    },
    {
      "parameters": {
        "url": "={{ $json.detail_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        464,
        704
      ],
      "id": "40480f08-991e-497f-bf08-8bc2fa87a572",
      "name": "Ambil Detail Dokumen",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst seen = new Set();\n\n// Status keberlakuan dan judul dibaca dari halaman detail JDIH.\n// Jika tidak terbaca, status = belum_diverifikasi (chatbot memberi catatan).\nconst plain = (s) => String(s || '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&').replace(/\\s+/g, ' ').trim();\n\nfunction legalStatus(html) {\n  const m = plain(html).match(/status(?:\\s+(?:peraturan|dokumen|hukum))?\\s*:?\\s*(tidak\\s+berlaku|dicabut|berlaku|diubah)/i);\n  if (!m) return 'belum_diverifikasi';\n  const v = m[1].toLowerCase().replace(/\\s+/g, ' ');\n  if (v === 'berlaku') return 'berlaku';\n  if (v === 'diubah') return 'belum_diverifikasi';\n  return 'tidak_berlaku';\n}\n\nfunction pageTitle(html) {\n  const candidates = [\n    (html.match(/<meta[^>]+property=[\"']og:title[\"'][^>]+content=[\"']([^\"']+)[\"']/i) || [])[1],\n    (html.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i) || [])[1],\n    (html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1],\n  ].map(plain).filter((t) => t.length >= 10);\n  return candidates.length ? candidates[0].slice(0, 500) : null;\n}\n\nfor (const item of $input.all()) {\n  const html = item.json.html || \"\";\n  const title = pageTitle(html);\n  const legal_status = legalStatus(html);\n\n  const matches = [...html.matchAll(\n    /(?:href|src)\\s*=\\s*[\"']([^\"']+\\.pdf(?:\\?[^\"']*)?)[\"']/gi\n  )];\n\n  for (const match of matches) {\n    let pdf_url = match[1].replace(/&amp;/g, \"&\");\n\n    if (pdf_url.startsWith(\"//\")) {\n      pdf_url = \"https:\" + pdf_url;\n    } else if (pdf_url.startsWith(\"/\")) {\n      pdf_url = \"https://jdih.kpu.go.id\" + pdf_url;\n    } else if (!/^https?:\\/\\//i.test(pdf_url)) {\n      pdf_url = \"https://jdih.kpu.go.id/\" + pdf_url;\n    }\n\n    if (!pdf_url.startsWith(\"https://jdih.kpu.go.id/\")) {\n      continue;\n    }\n\n    if (!pdf_url.includes(\"/data/data_pkpu/\")) {\n      continue;\n    }\n\n    if (seen.has(pdf_url)) continue;\n    seen.add(pdf_url);\n\n    results.push({\n      json: {\n        pdf_url,\n        source: \"JDIH KPU\",\n        document_type: \"PKPU\",\n        title,\n        legal_status,\n        detail_url: item.json.detail_url ?? null,\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        704
      ],
      "id": "976f3067-fe42-4835-a583-822a5b6ce112",
