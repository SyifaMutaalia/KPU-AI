        "hasOutputParser": true,
        "options": {
          "systemMessage": "=Kamu adalah agent yang hanya untuk merubah format file.\n\nEkstrak dokumen hukum KPU berikut menjadi JSON terstruktur.\n\nPertahankan seluruh isi Pasal, ayat, huruf, dan struktur hukum asli.\n\nJangan merangkum atau mengubah substansi.\n\nTeks dokumen:\n{{ $json.text }}",
          "enableStreaming": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1696,
        208
      ],
