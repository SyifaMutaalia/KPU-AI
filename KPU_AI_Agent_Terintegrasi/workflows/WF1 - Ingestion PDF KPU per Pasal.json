      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        2160,
        416
      ],
      "id": "c112e403-7b25-46be-94a1-0ea6ec31e8f2",
      "name": "Default Data Loader"
    },
    {
      "parameters": {
        "jsCode": "const html = $input.first().json.html || \"\";\n\nconst matches = [...html.matchAll(\n  /href\\s*=\\s*[\"']([^\"']+)[\"']/gi\n)];\n\nconst detailUrls = [...new Set(\n  matches.map(m => m[1]).filter(url =>\n    /^https:\\/\\/jdih\\.kpu\\.go\\.id\\/(peraturan-kpu|keputusan-kpu)\\/detail\\//i.test(url)\n  )\n)];\n\nreturn detailUrls.map(detail_url => ({\n  json: { detail_url, source: \"JDIH KPU\" }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        704
      ],
      "id": "b77cb3d0-8a58-4f8c-afe0-bf839e265dd8",
      "name": "ambil URL dan metadata PDF"
    },
    {
      "parameters": {
        "url": "={{ $json.detail_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        464,
        704
      ],
      "id": "40480f08-991e-497f-bf08-8bc2fa87a572",
      "name": "Ambil Detail Dokumen",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const results = [];\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const html = item.json.html || \"\";\n\n  const matches = [...html.matchAll(\n    /(?:href|src)\\s*=\\s*[\"']([^\"']+\\.pdf(?:\\?[^\"']*)?)[\"']/gi\n  )];\n\n  for (const match of matches) {\n    let pdf_url = match[1].replace(/&amp;/g, \"&\");\n\n    if (pdf_url.startsWith(\"//\")) {\n      pdf_url = \"https:\" + pdf_url;\n    } else if (pdf_url.startsWith(\"/\")) {\n      pdf_url = \"https://jdih.kpu.go.id\" + pdf_url;\n    } else if (!/^https?:\\/\\//i.test(pdf_url)) {\n      pdf_url = \"https://jdih.kpu.go.id/\" + pdf_url;\n    }\n\n    if (!pdf_url.startsWith(\"https://jdih.kpu.go.id/\")) {\n      continue;\n    }\n\n    if (!pdf_url.includes(\"/data/data_pkpu/\")) {\n      continue;\n    }\n\n    if (seen.has(pdf_url)) continue;\n    seen.add(pdf_url);\n\n    results.push({\n      json: {\n        pdf_url,\n        source: \"JDIH KPU\",\n        document_type: \"PKPU\"\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        704
      ],
