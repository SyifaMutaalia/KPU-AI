      "name": "Ada pdf_url?"
    },
    {
      "parameters": {
        "jsCode": "// Menyatukan jalur webhook dan jadwal harian sebelum download PDF.\nlet retryErrorId = null;\ntry {\n  if ($('Normalisasi Input Webhook').isExecuted) {\n    retryErrorId = $('Normalisasi Input Webhook').first().json.retry_error_id ?? null;\n  }\n} catch (e) { /* eksekusi dari jadwal */ }\n\nreturn $input.all().map((item, index) => {\n  let detail = {};\n  try { detail = $('Periksa Link Download').itemMatching(index).json; } catch (e) { /* jalur webhook */ }\n  const j = { ...detail, ...Object.fromEntries(Object.entries(item.json).filter(([, v]) => v !== null && v !== undefined)) };\n  const url = String(j.pdf_url);\n  let fileName = '';\n  try { fileName = decodeURIComponent(new URL(url).pathname.split('/').pop() || ''); } catch (e) {}\n  const base = fileName.replace(/\\.pdf$/i, '').replace(/[_+]+/g, ' ').replace(/\\s+/g, ' ').trim();\n  const yearMatch = base.match(/\\b(?:19|20)\\d{2}\\b/);\n  const numberMatch = base.match(/(?:nomor|no\\.?|pkpu)\\s*(\\d+)/i);\n  return {\n    json: {\n      pdf_url: url,\n      source: j.source ?? 'JDIH KPU',\n      document_type: j.document_type ?? 'PKPU',\n      title: j.title ?? (base ? base.slice(0, 2000) : null),\n      document_number: j.document_number ?? (numberMatch ? numberMatch[1] : null),\n      year: j.year ?? (yearMatch ? Number(yearMatch[0]) : null),\n      legal_status: ['berlaku', 'tidak_berlaku'].includes(j.legal_status) ? j.legal_status : 'belum_diverifikasi',\n      retry_error_id: j.retry_error_id ?? retryErrorId,\n    },\n    pairedItem: { item: index },\n  };\n});\n"
      },
      "id": "8ed8e34e-b986-4a81-8439-c507bab03865",
